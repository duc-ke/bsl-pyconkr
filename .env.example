# 발급받은 NEIS Open API 키를 입력하세요.
NEIS_API_KEY=replace-with-your-neis-api-key

# 쉼표로 구분한 프론트엔드 Origin 목록입니다.
ALLOWED_ORIGINS=http://localhost:8080
WEB_PORT=8080
MCP_PORT=8001
AGENT_PORT=8002

# 멀티 에이전트가 사용할 GitHub Copilot 모델입니다.
COPILOT_MODEL=auto

# 컨테이너 실행 시 Copilot SDK 인증에 사용할 토큰입니다.
# 로컬에서는 로그인된 GitHub Copilot CLI 자격 증명을 사용할 수 있습니다.
GITHUB_TOKEN=
